// Go with a plugin of the project: build_go builds, runs and tests with the Go of go.dev
use "./go/plugin.build"

build_go("hello", directory = "hello", module = "example.com/hello", libraries = list("github.com/google/uuid@v1.6.0"))

// exactly this Go, also the go line of its go.mod
build_go("local", directory = "local", module = "example.com/local", version = "1.26.11")
