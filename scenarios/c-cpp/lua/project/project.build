use c

macos = operating_system() == "macos"

// the interpreter: lua.c has its main(), onelua.c is all of Lua in one file
build_c(
    "lua",
    list(),
    program = true,
    sources = list("*.c"),
    exclude = list("onelua.c"),
    include_dirs = list("."),
    defines = list("LUA_COMPAT_5_3", if macos { "LUA_USE_MACOSX" } else { "LUA_USE_LINUX" }),
    // macOS links readline for the REPL, Linux opens it at runtime
    link_flags = if macos { list("-lreadline") } else { list("-ldl") },
)
