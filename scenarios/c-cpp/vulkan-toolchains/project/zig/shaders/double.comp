#version 450
#extension GL_GOOGLE_include_directive : require

// what the numbers become, in a file of its own: a change of it translates the shader again
#include "lib/math.glsl"

layout(local_size_x = 16) in;

layout(std430, set = 0, binding = 0) buffer Numbers {
    uint values[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    values[i] = changed(values[i]);
}
