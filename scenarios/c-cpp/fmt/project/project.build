use cpp

build_cpp(
    "fmt",
    list(),
    // the C++20 module
    exclude = list("src/fmt.cc"),
    test_dependencies = list("gtest"),
    test_sources = list("test/*-test.cc", "test/test-main.cc", "test/gtest-extra.cc", "test/util.cc"),
    // those of the C++20 module, the header-only library, other flags or mocked POSIX
    test_exclude = list(
        "test/module-test.cc",
        "test/header-only-test.cc",
        "test/format-impl-test.cc",
        "test/no-builtin-types-test.cc",
        "test/scan-test.cc",
        "test/unicode-test.cc",
        "test/noexception-test.cc",
        "test/enforce-checks-test.cc",
        "test/posix-mock-test.cc",
    ),
    // a program per test, like CMake builds them
    test_programs = list("test/*-test.cc"),
    // clang with the ABI of MSVC ends the program with 0xc0000409 when an exception from an exception_ptr is
    // thrown again in the catch of another one: fmt writes nested exceptions so, it tests that only with MSVC
    test_arguments = if operating_system() == "windows" { list("--gtest_filter=-std_test.exception:std_test.exception_ptr") } else { list() },
)
