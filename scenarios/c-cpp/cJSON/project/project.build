use c

cjson = build_c(
    "cjson",
    list(),
    sources = list("cJSON.c", "cJSON_Utils.c"),
    include_dirs = list("."),
)

// the tests with Unity, in tests/, where they find their inputs
build_c(
    "cjson-tests",
    list(cjson),
    directory = "tests",
    test_sources = list("*.c", "unity/src/unity.c"),
    // a program per test, like CMake builds them
    test_programs = list("parse_*.c", "print_*.c", "*_tests.c", "cjson_add.c", "readme_examples.c"),
    // cJSON_Duplicate follows a circular reference 10000 deep, that needs more than the 1 MB stack of
    // Windows without optimizations: 8 MB like on Linux
    link_flags = if operating_system() == "windows" { list("-Wl,-stack:8388608") } else { list() },
)
