use android

repositories = list(google(), maven_central())
bom = platform("androidx.compose:compose-bom:2026.06.01")

core = build_android_library(
    "shortcut-core",
    "com.mehdi.shortcut",
    list("androidx.core:core-ktx:1.19.0"),
    repositories,
    min_sdk = 23,
    compile_sdk = 37,
    directory = "shortcut-core",
)

compose = build_android_library(
    "shortcut-compose",
    "com.mehdi.shortcut.compose",
    list(core, bom, "androidx.compose.runtime:runtime", "androidx.compose.ui:ui", "androidx.core:core-ktx:1.19.0"),
    repositories,
    plugins = list("compose"),
    min_sdk = 23,
    compile_sdk = 37,
    directory = "shortcut-compose",
)

app = build_android(
    "shortcut-demo",
    "com.mehdi.shortcutdemo",
    list(
        core,
        compose,
        bom,
        "androidx.appcompat:appcompat:1.7.1",
        "androidx.constraintlayout:constraintlayout:2.2.1",
        "androidx.activity:activity-compose:1.13.0",
        "androidx.compose.material3:material3",
    ),
    repositories,
    plugins = list("compose"),
    min_sdk = 23,
    compile_sdk = 37,
    target_sdk = 37,
    directory = "app",
)
