use android

compose = "1.9.1"
repositories = list(google(), maven_central(), maven("https://jitpack.io"))

// the database code from src/main/sqldelight, like the SQLDelight Gradle plugin.
// SQLDelight has no command line: its compiler runs through a driver in build-tools/
database = generate_sources(
    "sqldelight",
    tool = list(
        "com.squareup.sqldelight:gradle-plugin:1.5.5",
        // its IntelliJ core reads misc/registry.properties from the Kotlin compiler
        "org.jetbrains.kotlin:kotlin-compiler-embeddable:1.5.31",
    ),
    repositories,
    main_class = "SqlDelightDriver",
    tool_sources = list("build-tools/SqlDelightDriver.java"),
    args = list("com.farmerbb.notepad", "Database", "src/main/sqldelight", "{output}", "."),
    inputs = list("src/main/sqldelight"),
    directory = "app",
)

app = build_android(
    "notepad",
    "com.farmerbb.notepad",
    list(
        "androidx.activity:activity-ktx:1.11.0",
        "androidx.core:core-ktx:1.17.0",
        "androidx.datastore:datastore-preferences:1.0.0",
        "androidx.preference:preference-ktx:1.2.1",
        "androidx.activity:activity-compose:1.11.0",
        "androidx.compose.foundation:foundation:" + compose,
        "io.insert-koin:koin-androidx-compose:4.1.1",
        "androidx.compose.material:material:" + compose,
        "androidx.compose.material:material-icons-extended:1.7.8",
        "androidx.compose.ui:ui:" + compose,
        "androidx.compose.ui:ui-tooling-preview:" + compose,
        "androidx.compose.ui:ui-tooling:" + compose,
        "androidx.lifecycle:lifecycle-viewmodel-compose:2.9.3",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2",
        "com.squareup.sqldelight:coroutines-extensions:1.5.5",
        "com.squareup.sqldelight:android-driver:1.5.5",
        "io.insert-koin:koin-android:4.1.1",
        "io.insert-koin:koin-core:4.1.1",
        "com.halilibo.compose-richtext:richtext-commonmark:0.16.0",
        "com.halilibo.compose-richtext:printing:0.16.0",
        "com.github.NoelChew.ComposePreferences:preferences-material:0.1.5-9",
        "com.github.K1rakishou:Fuck-Storage-Access-Framework:v1.1.3",
        "com.github.firefinchdev:linkify-text:0a45dbcf9b",
        "com.squareup.okio:okio:3.16.0",
        "com.google.accompanist:accompanist-systemuicontroller:0.36.0",
        "org.jetbrains.kotlinx:kotlinx-serialization-json:1.9.0",
    ),
    repositories,
    application_id = "com.farmerbb.notepad.debug",
    min_sdk = 21,
    compile_sdk = 36,
    target_sdk = 35,
    version_code = 122,
    version_name = "3.0.6",
    plugins = list("compose", "serialization"),
    kotlin_args = list("-opt-in=kotlin.RequiresOptIn"),
    generated_sources = list(database),
    manifest_placeholders = list("appName=@string/app_name_debug"),
    build_config_fields = list("long TIMESTAMP " + current_time_millis() + "L"),
    core_library_desugaring = "2.1.5",
    directory = "app",
)
