use android

repositories = list(google(), maven_central())

library = build_android_library(
    "html-dsl",
    "com.jaredrummler.htmldsl",
    list("androidx.core:core-ktx:1.5.0"),
    repositories,
    min_sdk = 16,
    // transitive R classes, the default of the Android Gradle plugin 4.2 of the project
    non_transitive_r_class = false,
    directory = "library",
)

demo = build_android(
    "demo",
    "com.jaredrummler.htmldsl.demo",
    list(
        library,
        "androidx.navigation:navigation-fragment-ktx:2.3.5",
        "androidx.navigation:navigation-ui-ktx:2.3.5",
        "androidx.core:core-ktx:1.5.0",
        "androidx.appcompat:appcompat:1.3.0",
        "androidx.constraintlayout:constraintlayout:2.0.4",
        "com.google.android.material:material:1.3.0",
        "com.ogaclejapan.smarttablayout:library:2.0.0",
        "com.ogaclejapan.smarttablayout:utils-v4:2.0.0",
        "com.blacksquircle.ui:editorkit:2.0.0",
        "com.blacksquircle.ui:language-kotlin:2.0.0",
        "com.blacksquircle.ui:language-html:2.0.0",
        "com.github.bumptech.glide:glide:4.12.0",
    ),
    repositories,
    min_sdk = 28,
    target_sdk = 30,
    // transitive R classes, the default of the Android Gradle plugin 4.2 of the project
    non_transitive_r_class = false,
    directory = "demo",
)
